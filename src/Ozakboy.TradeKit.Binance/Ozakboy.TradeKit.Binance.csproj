<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Ozakboy.TradeKit.Binance</PackageId>
    <AssemblyName>Ozakboy.TradeKit.Binance</AssemblyName>
    <RootNamespace>Ozakboy.TradeKit.Binance</RootNamespace>

    <Title>Ozakboy.TradeKit.Binance — 幣安 USDⓈ-M 永續合約交易所實作</Title>
    <Description>Ozakboy.TradeKit.Abstractions 的幣安 USDⓈ-M 永續合約實作,建構在 Ozakboy.Http 的簽章／限流／重試管線之上,不使用任何第三方社群套件。本版提供交易規則(exchangeInfo 的 PRICE_FILTER / LOT_SIZE / MIN_NOTIONAL / MARKET_LOT_SIZE)對映與每日快照快取、伺服器時間、帳戶與持倉查詢,以及下單、撤單、查單與槓桿／保證金模式設定(下單一律不可重試,並以 clientOrderId 作為冪等識別碼),再加上幣安錯誤碼到交易所中立錯誤碼的完整對映(時間戳偏移、簽章無效、IP 白名單、保證金不足、限流各自可辨識)。REST 與 WebSocket 端點以「環境」成組提供,杜絕主網與 Testnet 混接;交易規則快取以環境為鍵,避免 Testnet 的步進值被誤用到主網。行情方面提供歷史 K 線查詢,以及 WebSocket 的 K 線與標記價訂閱(連線管理、重連與重連後重放訂閱取自 Ozakboy.WebSockets);K 線的「是否已收盤」逐筆正確對映,REST 回應沒有這個旗標的部分則以收盤時間推得,策略不會拿到未收盤的 K 線當成收盤資料。使用者資料串流提供委託、成交、帳戶增量、保證金追繳與對帳訊號五種訂閱:單一連線內部分流,listenKey 自動建立／續期／重建／刪除,以 LIST_SUBSCRIPTIONS 心跳做閒置偵測;跟不上的訂閱者以失敗結束而不靜默丟棄事件,串流憑證不進任何錯誤與日誌。A Binance USDⓈ-M perpetual futures implementation of Ozakboy.TradeKit.Abstractions, built on the Ozakboy.Http signing, rate-limiting, and retry pipeline with no third-party dependencies. This release covers exchange-info trading rules with a per-environment daily cache, server time, account and position queries, order placement, cancellation and lookup, leverage and margin mode, and a full Binance-to-neutral error code mapping. Order placement is never retried and carries a clientOrderId as its idempotency key. Market data covers historical klines plus WebSocket kline and mark price subscriptions, with the candle closed flag mapped from the stream and derived from the close time on REST, never assumed. The user data stream covers order updates, fills, account deltas, margin calls, and resync signals over one fanned-out connection, with a fully managed listenKey and heartbeat-based idle detection; a subscriber that falls behind ends with a failure instead of silently losing events, and the stream credential never reaches an error or a log.</Description>
    <PackageTags>ozakboy;tradekit;binance;binance-futures;usds-m;perpetual;futures;exchange;trading;exchangeinfo;tick-size;step-size;min-notional;order;idempotency;client-order-id;no-retry;websocket;market-data;kline;candlestick;mark-price;streaming;user-data-stream;listen-key;order-updates;account-updates;margin-call;hmac-sha256;rate-limit;testnet;result-type;decimal;dotnet;csharp</PackageTags>

    <PackageProjectUrl>https://github.com/ozakboy/Ozakboy.TradeKit.Binance</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ozakboy/Ozakboy.TradeKit.Binance</RepositoryUrl>
    <PackageReleaseNotes>0.1.2 — Moves to Ozakboy.Http 0.3.0, whose pipeline now runs retry, then rate limiting, then signing, then logging. Every retry waits for its own rate-limit permit, pays its own weight, and is signed afresh, and the Binance timestamp parameter is restamped with the current time on each attempt, so a retry after a long backoff is no longer rejected with -1021 (0.1.1 re-sent the first attempt's timestamp and signature). The HttpPipelineClient is now created with CreateOzakboyHttpPipelineClient, so every error the REST client returns is masked against the registered API key and secret. Behaviour inherited from Ozakboy.Http 0.3.0: a local rate-limit timeout is not retried, and Error.Exception is a SanitizedException rather than the original exception. No public API changes. Full notes: https://github.com/ozakboy/Ozakboy.TradeKit.Binance/blob/main/CHANGELOG.md</PackageReleaseNotes>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    這兩個命名空間幾乎每個檔案都用到(Result/Error 與全部交易模型),集中宣告成隱含 using,
    避免每個檔案開頭重複四行,也避免 XML 註解裡的 cref 反過來讓 IDE0005 判成未使用的 using。
    Both namespaces are used by almost every file, so they are declared once as implicit usings.
  -->
  <ItemGroup>
    <Using Include="Ozakboy.Core.Abstractions" />
    <Using Include="Ozakboy.TradeKit.Abstractions" />
  </ItemGroup>

  <!-- 內部解析輔助型別需要直接測試,它們不屬於公開契約。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Ozakboy.TradeKit.Binance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    相依政策:只允許 .NET BCL、Microsoft 官方套件與 Ozakboy.* 自研套件,判定看「遞移相依」而非套件名稱。
    這正是本套件存在的理由 —— 幣安的第三方社群套件(Binance.Net 等)一律不使用。
    Ozakboy.Core.Abstractions 仍然明確指定 0.3.0。TradeKit.Abstractions 0.2.0 起遞移帶的已經就是 0.3.0,
    但明寫的成本是一行、拿掉的代價是下次上游降版時無聲還原到舊版,所以留著。
    Dependency policy: only the .NET BCL, first-party Microsoft packages, and Ozakboy.* packages, judged by the
    transitive graph rather than by package name — which is the whole reason this package exists instead of a
    community Binance client. Ozakboy.Core.Abstractions stays pinned even though TradeKit.Abstractions 0.2.0
    already carries 0.3.0 transitively: the pin costs one line and removing it would let a future upstream
    downgrade restore an older version in silence.
  -->
  <ItemGroup>
    <PackageReference Include="Ozakboy.TradeKit.Abstractions" Version="0.3.0" />
    <PackageReference Include="Ozakboy.Http" Version="0.3.0" />
    <PackageReference Include="Ozakboy.Core.Abstractions" Version="0.3.0" />
    <!--
      行情串流的連線管理(重連、重連後重放訂閱、閒置逾時存活偵測、有界佇列背壓)一律用這個套件,
      本套件不自己實作。它的遞移相依只有 Microsoft.Extensions.Logging.Abstractions 與
      Ozakboy.Core.Abstractions 0.3.0(與上面那一行同版),整棵樹仍然沒有任何第三方社群套件。
      All market stream connection management — reconnection, subscription replay, idle-timeout liveness, and
      bounded-queue backpressure — comes from this package rather than being reimplemented here. It brings in
      only Microsoft.Extensions.Logging.Abstractions and the same Ozakboy.Core.Abstractions 0.3.0 pinned above,
      so the transitive graph still contains no community package.
    -->
    <PackageReference Include="Ozakboy.WebSockets" Version="0.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <!--
    刻意不引用 Microsoft.SourceLink.GitHub 套件,與其他 Ozakboy.* 套件一致。
    自 .NET 8 起 SourceLink 已內建於 SDK,設定 PublishRepositoryUrl 與 EmbedUntrackedSources
    (見 Directory.Build.props)即可;外掛套件反而會帶進有安全通報的相依,
    在 TreatWarningsAsErrors 之下讓「還原」階段就直接失敗。
  -->

</Project>
