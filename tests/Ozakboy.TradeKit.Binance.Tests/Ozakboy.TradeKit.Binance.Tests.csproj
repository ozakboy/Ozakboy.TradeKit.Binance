<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>

    <!--
      改用 MSTest 內建的 Microsoft.Testing.Platform 執行器,不走舊的 VSTest。
      理由是相依政策:VSTest 那條路徑會經由 Microsoft.TestPlatform.ObjectModel 遞移帶進
      Newtonsoft.Json —— 它掛在 Microsoft 的套件底下,但本身是第三方社群套件,
      而本專案的判定標準是遞移相依而非套件名稱。換成 MTP 之後整棵相依樹只剩 Microsoft.*、System.* 與 Ozakboy.*。
      搭配 repo 根目錄的 global.json(test.runner),.NET 10 的 dotnet test 才會走 MTP。
      Uses MSTest's built-in Microsoft.Testing.Platform runner instead of the legacy VSTest path, because the
      VSTest path transitively drags in the third-party Newtonsoft.Json. The repo-level global.json
      (test.runner) is what makes dotnet test on .NET 10 pick MTP up.
    -->
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.1.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ozakboy.TradeKit.Binance\Ozakboy.TradeKit.Binance.csproj" />
  </ItemGroup>

  <!-- 合約測試的錄製回應。內容與取得方式見 Fixtures\PROVENANCE.md。 -->
  <ItemGroup>
    <None Update="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Ozakboy.Core.Abstractions" />
    <Using Include="Ozakboy.TradeKit.Abstractions" />
    <Using Include="Ozakboy.TradeKit.Binance" />
  </ItemGroup>

</Project>
